{
  "name": "sekro-download-manager",
  "version": "1.0.0",
  "description": "Sekro Download Manager — Gestor de descargas portable para Windows con descargas multi-hilo, pausa/reanudar y aceleración",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:all": "electron-builder --win portable nsis"
  },
  "author": "iSekro",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sekro.downloadmanager",
    "productName": "Sekro Download Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "download-engine.js",
      "index.html",
      "app.js",
      "styles.css"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": null
    },
    "portable": {
      "artifactName": "SekroDownloadManager-${version}-Portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SekroDownloadManager-${version}-Setup.${ext}"
    }
  }
}
