{
  "name": "app-sencilla",
  "version": "1.0.0",
  "description": "Aplicación de escritorio de lista de tareas hecha con Electron, HTML, CSS y JavaScript.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "dist": "electron-builder --win",
    "dist:all": "electron-builder --win --mac --linux"
  },
  "keywords": ["electron", "todo", "desktop"],
  "author": "iSekro",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.isekro.app-sencilla",
    "productName": "Lista de Tareas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "app.js",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.png",
      "uninstallerIcon": "icon.png"
    }
  }
}
